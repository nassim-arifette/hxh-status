# Google Gemini key used only by the GitHub Actions analysis job.
GEMINI_API_KEY=

# Official X API credentials used by the togashi-events Cloudflare Worker.
X_BEARER_TOKEN=
X_CONSUMER_SECRET=

# Fine-grained GitHub token limited to nassim-arifette/hxh-status.
# Required permissions: Metadata read, Contents read, Actions read/write.
GITHUB_AUTOMATION_TOKEN=

# Optional Gemini model override for local automation runs.
GEMINI_MODEL=gemini-3.7-flash
