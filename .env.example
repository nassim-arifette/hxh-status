# Google Gemini key used only by the GitHub Actions analysis job.
GEMINI_API_KEY=

# Official X API credentials used by the togashi-events Cloudflare Worker.
X_BEARER_TOKEN=
X_CONSUMER_SECRET=
# Random base64url value (at least 32 bytes) embedded only in the X callback URL.
X_WEBHOOK_PATH_SECRET=

# Fine-grained GitHub token limited to nassim-arifette/hxh-status.
# Required permissions: Metadata read, Contents read, Actions read/write.
GITHUB_AUTOMATION_TOKEN=

# One independent 32-byte-or-longer secret. Configure the same value as a
# togashi-events Worker secret and a GitHub Actions repository secret.
AUTOMATION_PAYLOAD_SECRET=

# Private half of the stable Web Push VAPID key pair. Worker secret only.
VAPID_PRIVATE_KEY=

# Optional Gemini model override for local automation runs.
GEMINI_MODEL=gemini-3.7-flash
