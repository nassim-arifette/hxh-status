{
  "name": "hxh-status",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sw-copy.mjs && next build && node scripts/set-html-lang.mjs && node scripts/generate-status-json.mjs && node scripts/generate-public-api.mjs && node scripts/inject-csp-hashes.mjs",
    "sw:copy": "node scripts/generate-sw-copy.mjs",
    "share:build": "npm run build && playwright install --only-shell chromium && node scripts/generate-share-images.mjs",
    "start": "wrangler dev",
    "lint": "eslint .",
    "test": "node --test \"{automation,worker}/**/*.test.mjs\"",
    "translations:check": "node scripts/check-translations.mjs",
    "push:setup-local": "node scripts/setup-local-push.mjs",
    "push:send-local": "node scripts/send-local-push.mjs",
    "automation:test": "npm test",
    "automation:process": "node scripts/process-togashi-events.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:dev:cron": "npm run build && wrangler dev --test-scheduled",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:deployments": "wrangler deployments list",
    "cf:logs": "wrangler tail"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
