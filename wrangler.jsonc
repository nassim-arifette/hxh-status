{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hxhstatus",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "PUSH_SUBSCRIPTIONS",
      "id": "3851985703a94cffa6a925d1dbbf5eb2"
    }
  ],
  "main": "./worker/index.mjs",
  "ratelimits": [
    {
      "name": "PUSH_RATE_LIMITER",
      "namespace_id": "4202026093",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_REGISTRY",
        "class_name": "PushSubscriptionRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PushSubscriptionRegistry"]
    }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "PUSH_NOTIFICATIONS_ENABLED": "true",
    "VAPID_PUBLIC_KEY": "BDDiMqC-8OtxjviwRNsKba57GJWACZJXDfL1Snw6uLCeJZxs-fTQEF6-NrKe0vuhfSU3E72Jgtd1at7NpWmGZKc",
    "VAPID_SUBJECT": "mailto:contact@hxhstatus.com",
    "PUSH_ACTIVE_SUBSCRIPTION_LIMIT": "5000",
    "PUSH_PENDING_SUBSCRIPTION_LIMIT": "256"
  },
  // Static files still bypass the Worker whenever an asset matches. The Worker
  // handles the push API and delegates unmatched HTTP requests back to ASSETS.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
