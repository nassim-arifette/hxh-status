{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hxhstatus",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "PUSH_SUBSCRIPTIONS",
      "id": "3851985703a94cffa6a925d1dbbf5eb2"
    }
  ],
  "d1_databases": [{"binding":"GAME_DB","database_name":"hxh-predictions","database_id":"85d4e669-1f36-4f2e-a517-63135f8aa0f0","migrations_dir":"migrations"}],
  "main": "./worker/index.mjs",
  "ratelimits": [
    {"name":"GAME_WRITE_LIMITER","namespace_id":"4212026091","simple":{"limit":20,"period":60}},
    {"name":"GAME_READ_LIMITER","namespace_id":"4212026092","simple":{"limit":120,"period":60}},
    {
      "name": "PUSH_RATE_LIMITER",
      "namespace_id": "4202026093",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_REGISTRY",
        "class_name": "PushSubscriptionRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PushSubscriptionRegistry"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "GAME_ENABLED": "false",
    "GAME_TURNSTILE_SITE_KEY": "0x4AAAAAAExZydRLNp7VcCZS",
    "GAME_EMAIL_ENABLED": "false",
    "GAME_PUBLIC_ORIGIN": "https://hxhstatus.com",
    "GAME_EMAIL_FROM": "HxH Status <pronostics@hxhstatus.com>",
    "PUSH_NOTIFICATIONS_ENABLED": "true",
    "VAPID_PUBLIC_KEY": "BDDiMqC-8OtxjviwRNsKba57GJWACZJXDfL1Snw6uLCeJZxs-fTQEF6-NrKe0vuhfSU3E72Jgtd1at7NpWmGZKc",
    "VAPID_SUBJECT": "mailto:contact@hxhstatus.com",
    "PUSH_ACTIVE_SUBSCRIPTION_LIMIT": "5000",
    "PUSH_PENDING_SUBSCRIPTION_LIMIT": "256"
  },
  // Static files still bypass the Worker whenever an asset matches. The Worker
  // handles the push API and delegates unmatched HTTP requests back to ASSETS.
  "assets": {
    "directory": "./out",
    // The Worker negotiates the root locale and owns the push API. Static
    // pages/assets still bypass it, which keeps the fast asset path intact.
    "run_worker_first": ["/", "/api/push/*", "/api/game/*"],
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
