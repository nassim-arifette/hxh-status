# Baseline hardening for every document and asset. More specific blocks below
# re-declare what they need to differ on; `/sw.js` keeps its own stricter CSP.
#
# `output: export` leaves no request-time hook to mint a nonce. The wildcard is
# therefore only a fallback for unmatched 404 paths and permits inline scripts.
# scripts/inject-csp-hashes.mjs appends a second, hash-only CSP for every real
# page. Browsers enforce both policies together, so known pages remain restricted
# to their exact build-time hashes while the fallback never breaks hydration.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pbs.twimg.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests

/opengraph-image
  Content-Type: image/png

/status.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/api/v1/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/releases.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# The filename is stable but the image is regenerated on every status change,
# so `immutable` served a chart that could never refresh. Revalidation is cheap
# against the ETag, and consumers can pin a version with ?r=<revision>.
/share/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/share/*/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/badge/*.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/badge/*/*.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/_next/static/*
  Cache-Control: public, max-age=31556952, immutable

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self'
  Service-Worker-Allowed: /
  X-Content-Type-Options: nosniff
